BOOKING_RECEIVER_EMAIL=contact@goclean.lu

# Recommended for deployment, especially on Vercel:
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=GoClean Lux <booking@your-verified-domain.com>

# Optional local fallback if you prefer SMTP:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TIMEOUT_MS=6000
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=GoClean Lux <contact@goclean.lu>

# Free automatic backup notification through Telegram:
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_CHAT_ID=your_private_chat_id

# Optional automatic WhatsApp Business Cloud notification:
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_RECIPIENT=352661920598
WHATSAPP_API_VERSION=v23.0
# For production-initiated notifications, use an approved template:
WHATSAPP_TEMPLATE_NAME=booking_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Make.com, Zapier, or custom webhook backup:
BOOKING_WEBHOOK_URL=https://example.com/booking-webhook
BOOKING_WEBHOOK_SECRET=optional_shared_secret
